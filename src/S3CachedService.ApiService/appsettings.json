{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://fps-admin-stage.devol.xyz",
      "https://fps-admin.devol.xyz"
    ],
    "AllowedMethods": [ "GET" ],
    "ExposedHeaders": [ "Content-Disposition", "Content-Length" ],
    "AllowCredentials": false,
    "MaxAgeSeconds": 3600
  },
  "AllowedHosts": "*",
  "AWS": {
    "AccessKey": "SimpleAccessKey",
    "SecretKey": "SimpleSecretKey",
    "S3": {
      "UseHttp": true,
      "ForcePathStyle": true,
      "ServiceURL": "http://localhost:9000/"
    }
  },
  "QueueSettings": {
    "DataPath": "CacheData",
    "MaxCount": 1000,
    "MaxBytes": 104857600 //100 mb
  }
}
